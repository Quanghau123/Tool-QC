{
  "name": "point-exchange",
  "transport": "http",
  "url": "http://127.0.0.1:2669",
  "persistArtifacts": true,
  "maxRequestBodyBytes": 10485760,
  "maxInMemoryExchanges": 1000,
  "routes": [
    {
      "method": "POST",
      "path": "/api/point-exchange-histories/bulk-sync",
      "status": 200,
      "name": "bulk-sync-default",
      "response": {
        "data": {
          "success": true,
          "code": "SYNC_COMPLETED",
          "message": "Đồng bộ thành công từ hệ thống đối tác giả lập",
          "summary": { "received": 1, "inserted": 1, "duplicated": 0, "failed": 0, "affectedRegistrations": 1 },
          "items": [
            {
              "transactionCode": "${request:$.data.activities.0.transactionCode}",
              "registrationSignedCode": "${request:$.data.activities.0.registrationSignedCode}",
              "status": "inserted",
              "code": null,
              "message": "Đã ghi nhận"
            }
          ]
        }
      }
    }
  ]
}
