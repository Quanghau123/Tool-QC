{
  "name": "replace-me",
  "baseUrlVariable": "API_BASE_URL",
  "errorCatalogue": {
    "path": "error-catalogue.json"
  },
  "apiBuilder": {
    "openApiPath": "openapi/openapi.json",
    "sourcePath": "source"
  },
  "defaultHeaders": { "Accept": "application/json" },
  "authentication": {
    "strategy": "login",
    "loginPath": "${env:AUTH_LOGIN_PATH}",
    "method": "POST",
    "body": { "username": "${env:AUTH_USERNAME}", "password": "${env:AUTH_PASSWORD}" },
    "tokenPath": "$.accessToken",
    "header": "Authorization",
    "prefix": "Bearer"
  },
  "safety": { "productionHosts": ["api.company.com"] }
}
