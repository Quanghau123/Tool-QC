# Local configuration and secrets
.env
*.local.*
*.tokens.ps1

# Unified generated output
.artifacts/

# Legacy generated-output locations; retained so existing local runs stay ignored
TestResults/
test-results/
integration-results/
message-results/
reports/

# Temporary diagnostics and tool state
.tmp*
*.log
.build-verify/
.dotnet-home/
.dotnet_cli_home/

# Testcase authoring scratch files; committed JSON testcases remain source code
projects/*/testcases/**/*.working
projects/*/testcases/**/*.working.json
projects/*/testcases/**/*.tmp

# Project-specific configurations and testcases are local-only.
# Keep only the reusable project template under version control.
projects/*/
!projects/project-template/
!projects/project-template/**

# Local agent worktrees and code-analysis caches
.claude/worktrees/
graphify-out/

# TDQ runtime state; authored brief/spec/plan/QC/report documents remain tracked
docs/tdq/.tdq-*
docs/tdq/stop_streak.json

# Build output
bin/
obj/

# Node development dependencies
node_modules/
