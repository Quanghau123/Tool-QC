# TOOL-QC
TEST_ENV=local
ACTIVE_PROJECT=ops-service
TEST_TAGS=
ARTIFACTS_DIR=.artifacts
TEST_RESULTS_DIR=.artifacts/test-runs
MAX_PARALLEL_CASES=1
JUNIT_REPORT_ENABLED=true
ALLOW_PRODUCTION=false
ALLOW_DESTRUCTIVE_TESTS=true

# REDIS
REDIS_CONNECTION_STRING=

# HTTP STUB
HTTP_STUB_HOST=127.0.0.1
HTTP_STUB_PORT=0
HTTP_STUB_BASE_URL=http://127.0.0.1:2669

# JMETER
JMETER_HOME=

# LOAD TEST
LOAD_MODE=control
LOAD_WORKERS=2
LOAD_ITERATIONS=1
LOAD_WARMUP_ITERATIONS=1
LOAD_RESOURCE_POOL_SIZE=2
LOAD_REQUEST_TIMEOUT_MS=15000
LOAD_SLOW_THRESHOLD_MS=2000
LOAD_RETRY_ENABLED=false
LOAD_MAX_RETRY_ATTEMPTS=1
LOAD_RANDOM_SEED=20260906
LOAD_QUANTITY=1
LOAD_BARRIER_TIMEOUT_MS=30000
LOAD_BATCH_COOLDOWN_MS=0
LOAD_DIAGNOSTICS_ENABLED=true
LOAD_POST_FAILURE_VERIFICATION_ENABLED=false
LOAD_OUTPUT_JSONL=
LOAD_OUTPUT_MARKDOWN=
CONFIRM_LOAD_RUN=false

# TESTCASE GENERATOR
TESTCASE_GENERATOR_MODE=auto
TESTCASE_GENERATOR_PROVIDER=codex-cli
# 0 = không giới hạn; chỉ đặt số giây khi muốn tự động dừng AI
TESTCASE_GENERATOR_TIMEOUT_SECONDS=0
TESTCASE_GENERATOR_FALLBACK_ENABLED=true
