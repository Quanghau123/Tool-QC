# Tên môi trường đang kiểm thử, ví dụ: local, dev, staging hoặc uat.
TEST_ENV=local
# Tên project trong thư mục projects/, ví dụ: ops-service.
ACTIVE_PROJECT=ops-service
# Danh sách tag cần chạy, phân cách bằng dấu phẩy, ví dụ: smoke,booths.
TEST_TAGS=
# Thư mục lưu báo cáo HTML. Đường dẫn tương đối được tính từ thư mục repository.
TEST_RESULTS_DIR=test-results
# Chỉ đặt true khi chủ động cho phép chạy vào host production khai báo trong project.json.
ALLOW_PRODUCTION=false
# Chỉ đặt true trên môi trường test cô lập để cho phép test tạo, sửa hoặc xóa dữ liệu.
ALLOW_DESTRUCTIVE_TESTS=false

# URL gốc của API cần kiểm thử, ví dụ: http://localhost:5007 (không thêm endpoint cụ thể).
API_BASE_URL=http://localhost:5007
# Thời gian tối đa chờ một HTTP request, tính bằng giây.
API_TIMEOUT_SECONDS=30

# Kiểu xác thực của môi trường; giữ đồng bộ với authentication.strategy trong project.json.
AUTH_TYPE=None
# JWT/API token khi project dùng static-token. Chỉ đặt trong .env hoặc biến môi trường CI.
AUTH_TOKEN=
# URL gốc của máy chủ xác thực nếu khác API_BASE_URL; để trống khi không dùng.
AUTH_BASE_URL=
# Client ID của OAuth/client-credentials; để trống nếu cơ chế xác thực không yêu cầu.
AUTH_CLIENT_ID=
# Client secret đi cùng AUTH_CLIENT_ID; để trống nếu không dùng.
AUTH_CLIENT_SECRET=
# Tên đăng nhập dùng cho chiến lược login; để trống nếu dùng static-token.
AUTH_USERNAME=
# Mật khẩu dùng cho chiến lược login; để trống nếu dùng static-token.
AUTH_PASSWORD=

# Loại database, ví dụ: PostgreSQL; hiện runner chưa hỗ trợ assertion database trực tiếp.
DB_PROVIDER=PostgreSQL
# Chuỗi kết nối database test; để trống nếu testcase không sử dụng.
DB_CONNECTION_STRING=

# Chuỗi kết nối Redis test; hiện runner chưa hỗ trợ assertion Redis trực tiếp.
REDIS_CONNECTION_STRING=

# URL Elasticsearch của môi trường test; để trống nếu testcase không sử dụng.
ELASTICSEARCH_URL=
# Host MQTT, không kèm protocol hoặc port; để trống nếu testcase không sử dụng MQTT.
MQTT_HOST=
# Cổng MQTT, ví dụ: 1883 hoặc 8883.
MQTT_PORT=1883
# Tên đăng nhập MQTT của môi trường test.
MQTT_USERNAME=
# Mật khẩu MQTT của môi trường test.
MQTT_PASSWORD=
# AWS Region chứa tài nguyên test, ví dụ: ap-southeast-1.
AWS_REGION=
# AWS access key của tài khoản test; nên cấp quyền tối thiểu.
AWS_ACCESS_KEY_ID=
# AWS secret access key đi cùng access key của tài khoản test.
AWS_SECRET_ACCESS_KEY=
# Tên S3 bucket dành cho môi trường test; không dùng bucket production.
AWS_S3_BUCKET=
