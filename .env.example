# Select the target environment: local, dev, staging, uat, etc.
TEST_ENV=local
ACTIVE_PROJECT=ops-service
TEST_TAGS=
ALLOW_PRODUCTION=false
ALLOW_DESTRUCTIVE_TESTS=false

# API
API_BASE_URL=http://localhost:5007
API_TIMEOUT_SECONDS=30

# Authentication (leave unused values empty)
AUTH_TYPE=None
AUTH_TOKEN=
AUTH_BASE_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=

# Database
DB_PROVIDER=PostgreSQL
DB_CONNECTION_STRING=

# Redis
REDIS_CONNECTION_STRING=

# Optional services
ELASTICSEARCH_URL=
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
