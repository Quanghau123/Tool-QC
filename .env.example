TEST_ENV=local
ACTIVE_PROJECT=ops-service
# Danh sách tag cần chạy, phân cách bằng dấu phẩy, ví dụ: smoke,booths.
TEST_TAGS=
ARTIFACTS_DIR=.artifacts
TEST_RESULTS_DIR=.artifacts/test-runs
ALLOW_PRODUCTION=false
ALLOW_DESTRUCTIVE_TESTS=true

API_BASE_URL=http://localhost:5007
ONLINE_API_BASE_URL=http://localhost:5007
OFFLINE_API_BASE_URL=http://localhost:5008
API_TIMEOUT_SECONDS=30

# HTTP stub dùng chung để giả lập hệ thống tích hợp trong môi trường test.
HTTP_STUB_HOST=127.0.0.1
HTTP_STUB_PORT=0
HTTP_STUB_BASE_URL=http://127.0.0.1:2669
PROFILE_BONUS_STUB_BASE_URL=http://127.0.0.1:2670

AUTH_TYPE=static-token
AUTH_TOKEN=

# Client ID của OAuth/client-credentials; để trống nếu cơ chế xác thực không yêu cầu.
AUTH_CLIENT_ID=
# Client secret đi cùng AUTH_CLIENT_ID; để trống nếu không dùng.
AUTH_CLIENT_SECRET=
# Tên đăng nhập dùng cho chiến lược login; để trống nếu dùng static-token.
AUTH_USERNAME=
# Mật khẩu dùng cho chiến lược login; để trống nếu dùng static-token.
AUTH_PASSWORD=

DB_PROVIDER=PostgreSql
DB_CONNECTION_STRING=
ONLINE_DB_CONNECTION_STRING=
OFFLINE_DB_CONNECTION_STRING=

REDIS_CONNECTION_STRING=

ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=
ONLINE_ELASTICSEARCH_URL=
ONLINE_ELASTICSEARCH_USERNAME=
ONLINE_ELASTICSEARCH_PASSWORD=
OFFLINE_ELASTICSEARCH_URL=
OFFLINE_ELASTICSEARCH_USERNAME=
OFFLINE_ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX_V1=
ELASTICSEARCH_INDEX_PREFIX_V2=

MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=
MQTT_CLIENT_ID=
MQTT_TIMEOUT_MS=10000
MQTT_LOG_PUBLISHED_MESSAGES=false
MQTT_TOPICS=[]
MQTT_AUTH_DB_HOST=
MQTT_AUTH_DB_PORT=
MQTT_AUTH_DB_DATABASE=mqtt_db
MQTT_AUTH_DB_USERNAME=
MQTT_AUTH_DB_PASSWORD=

# AWS Region chứa tài nguyên test, ví dụ: ap-southeast-1.
AWS_REGION=
# AWS access key của tài khoản test; nên cấp quyền tối thiểu.
AWS_ACCESS_KEY_ID=
# AWS secret access key đi cùng access key của tài khoản test.
AWS_SECRET_ACCESS_KEY=
# Tên S3 bucket dành cho môi trường test; không dùng bucket production.
AWS_S3_BUCKET=

# Redemption load runner
# Generic load-tool options. Project adapters may keep legacy variables during migration.
LOAD_MANIFEST=
LOAD_MODE=control
LOAD_WORKERS=2
LOAD_ITERATIONS=1
LOAD_WARMUP_ITERATIONS=1
LOAD_RESOURCE_POOL_SIZE=2
LOAD_REQUEST_TIMEOUT_MS=15000
LOAD_SLOW_THRESHOLD_MS=2000
LOAD_RETRY_ENABLED=false
LOAD_MAX_RETRY_ATTEMPTS=1
LOAD_RANDOM_SEED=20260906
LOAD_QUANTITY=1
LOAD_BARRIER_TIMEOUT_MS=30000
LOAD_BATCH_COOLDOWN_MS=0
LOAD_DIAGNOSTICS_ENABLED=true
LOAD_POST_FAILURE_VERIFICATION_ENABLED=false
LOAD_OUTPUT_JSONL=
LOAD_OUTPUT_MARKDOWN=
# Required when LOAD_WORKERS * LOAD_ITERATIONS is greater than 10.
CONFIRM_LOAD_RUN=false

# Legacy Redemption adapter variables.
REDEMPTION_LOAD_MANIFEST=
REDEMPTION_LOAD_MODE=control
REDEMPTION_LOAD_WORKERS=15
REDEMPTION_LOAD_ITERATIONS=1
REDEMPTION_LOAD_WARMUP_ITERATIONS=1
REDEMPTION_LOAD_GIFT_POOL_SIZE=15
REDEMPTION_LOAD_THINK_TIME_MS=0
REDEMPTION_LOAD_TIMEOUT_MS=15000
REDEMPTION_LOAD_SLOW_THRESHOLD_MS=2000
REDEMPTION_LOAD_RETRY_ENABLED=false
REDEMPTION_LOAD_MAX_RETRY_ATTEMPTS=1
REDEMPTION_LOAD_RANDOM_SEED=20260906
REDEMPTION_LOAD_QUANTITY=1
REDEMPTION_LOAD_OUTPUT_JSONL=
REDEMPTION_LOAD_OUTPUT_MARKDOWN=

# Dedicated redemption lock/reserved-quantity diagnostic.
REDEMPTION_DIAGNOSTIC_MANIFEST=
REDEMPTION_DIAGNOSTIC_SCENARIO=control
REDEMPTION_DIAGNOSTIC_WORKERS=15
REDEMPTION_DIAGNOSTIC_ITERATIONS=1
REDEMPTION_DIAGNOSTIC_REQUEST_TIMEOUT_SECONDS=30
REDEMPTION_DIAGNOSTIC_SLOW_THRESHOLD_MS=2000
REDEMPTION_DIAGNOSTIC_BETWEEN_REQUEST_DELAY_MS=0
REDEMPTION_DIAGNOSTIC_TEST_RUN_ID=
REDEMPTION_DIAGNOSTIC_OUTPUT_DIRECTORY=
ONSITE_CUSTOMER_LOAD_MANIFEST=
ONSITE_CUSTOMER_LOAD_MODE=baseline
ONSITE_CUSTOMER_LOAD_WORKERS=1
ONSITE_CUSTOMER_LOAD_ITERATIONS=20
ONSITE_CUSTOMER_LOAD_WARMUP_ITERATIONS=1
ONSITE_CUSTOMER_LOAD_PAGE_SIZE=20
ONSITE_CUSTOMER_LOAD_PAGE=1
ONSITE_CUSTOMER_LOAD_SCHEDULE=closed-loop
ONSITE_CUSTOMER_LOAD_TIMEOUT_MS=15000
ONSITE_CUSTOMER_LOAD_SLOW_THRESHOLD_MS=2000
ONSITE_CUSTOMER_LOAD_RETRY_ENABLED=false
ONSITE_CUSTOMER_LOAD_MAX_RETRY_ATTEMPTS=1
ONSITE_CUSTOMER_ADMIN_TOKEN_VARIABLE=AUTH_TOKEN
ONSITE_CUSTOMER_LOAD_OUTPUT_JSONL=
ONSITE_CUSTOMER_LOAD_OUTPUT_MARKDOWN=
# Modes bổ sung: connection-five, redemption-preflight, qc-combined.
EVENT_CUSTOMER_LOAD_MANIFEST=
EVENT_CUSTOMER_LOAD_MODE=baseline
EVENT_CUSTOMER_LOAD_WORKERS=1
EVENT_CUSTOMER_LOAD_ITERATIONS=1
EVENT_CUSTOMER_LOAD_PAGE_SIZE=200
EVENT_CUSTOMER_LOAD_MAX_PAGES=1
EVENT_CUSTOMER_LOAD_TIMEOUT_MS=15000
EVENT_CUSTOMER_LOAD_SLOW_THRESHOLD_MS=2000
EVENT_CUSTOMER_ADMIN_TOKEN_VARIABLE=AUTH_TOKEN
EVENT_CUSTOMER_LOAD_OUTPUT_JSONL=
EVENT_CUSTOMER_LOAD_OUTPUT_MARKDOWN=
WRISTBAND_ASSIGNMENT_MANIFEST=
WRISTBAND_ASSIGNMENT_MODE=smoke
WRISTBAND_ASSIGNMENT_WORKERS=10
WRISTBAND_ASSIGNMENT_TOTAL_REQUESTS=1000
WRISTBAND_ASSIGNMENT_TIMEOUT_MS=15000
WRISTBAND_ASSIGNMENT_SLOW_THRESHOLD_MS=2000
WRISTBAND_ASSIGNMENT_OUTPUT_JSONL=
WRISTBAND_ASSIGNMENT_OUTPUT_MARKDOWN=
# Add REDEMPTION_LOAD_DEVICE_TOKEN_01..15 only to .env or OS environment.
